<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/home">

    <fragment
        android:id="@+id/home"
        android:name="dev.bugcapsule.demo.HomeFragment"
        android:label="Shop" />

    <fragment
        android:id="@+id/cart"
        android:name="dev.bugcapsule.demo.CartFragment"
        android:label="Cart">
        <argument
            android:name="source"
            android:defaultValue="home"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/account"
        android:name="dev.bugcapsule.demo.AccountFragment"
        android:label="Account" />
</navigation>
